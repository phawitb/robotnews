{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/news",
      "destination": "/index.html"
    },
    {
      "source": "/news/",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/news",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/news/",
      "destination": "/en/index.html"
    }
  ]
}
